# Server Port
PORT=5050

# Upstream Proxy Configuration for VPS Deployment
# If your VPS Datacenter IP is blocked by nice444.com or Cloudflare,
# enter an Indian residential proxy or rotating proxy URL below.
# Format: http://username:password@proxy-host:proxy-port
# Or SOCKS5: socks5://username:password@proxy-host:proxy-port
# Leave empty if running on a clean / residential IP.
UPSTREAM_PROXY_URL=


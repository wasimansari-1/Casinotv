# ==============================================================================
# CasinoTV Live Stream Proxy Configuration
# ==============================================================================

# Server Port
PORT=5050

# Outbound Upstream Proxy (Tailscale Android 5G Residential Proxy)
# Format: http://100.127.231.58:8080
UPSTREAM_PROXY_URL=http://100.127.231.58:8080

# Redis Distributed Cache & Mutex Lock
# Used for cross-PM2 worker deduplication, single-flight locking, and shared cache.
# If Redis is offline or not installed, the engine automatically falls back to in-memory mode.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=casinotv:

# Provider Rate Limiter & Concurrency Configuration
PROVIDER_CONCURRENCY=1
PROVIDER_MIN_INTERVAL_MS=2000
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_1_MS=5000
PROVIDER_BACKOFF_2_MS=15000

# Circuit Breaker Cooldown (ms)
CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Default WatchLink Cache TTL (seconds)
# Used when upstream URL does not contain an explicit JWT `exp` timestamp.
WATCHLINK_CACHE_TTL_SEC=900
